# 1Password references resolved on the HOST by `op run --env-file`
# (deploy.sh). Values never enter the container image or git history.
# Field names match ~/.hermes/config.yaml env map.
AWS_ACCESS_KEY_ID = op://Infra/AWS - hermes1-local/access-key-id
AWS_SECRET_ACCESS_KEY = op://Infra/AWS - hermes1-local/secret-access-key
ANTHROPIC_API_KEY = op://hermes1/Anthropic/credential
